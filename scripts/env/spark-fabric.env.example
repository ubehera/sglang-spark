# sglang-spark deployment config. Copy to spark-fabric.env and fill it in.
#   Shell:   the launch scripts auto-source this (set -a; source ...; set +a).
#   systemd: EnvironmentFile=/etc/sglang-spark/spark-fabric.env (or your path).
#   Override the location with SGLANG_SPARK_ENV=/path/to/spark-fabric.env.
#
# KEY=VALUE only (no `export`, no $VAR expansion) so the file works in BOTH
# shell and systemd. Use absolute paths.

# ----- paths (deployment-specific; edit these) -----
# Custom sm_121-native NCCL build. The PyTorch-bundled libnccl lacks sm_121
# cubins, so cross-node TP collectives deadlock after ~30 min. See docs/recipes/.
NCCL_HOME=/opt/nccl-sm121
# Python venv with sglang + the sm_121a sgl-kernel wheel installed.
SGLANG_VENV=/opt/sglang/venv
# HuggingFace hub cache holding the model snapshots (local disk or NFS mount).
HF_HUB_CACHE=/mnt/models/hf-cache

# ----- secrets (set here, or export in the environment instead) -----
HF_TOKEN=
SGLANG_API_KEY=

# ----- multi-Spark TP=2 fabric (edit for your network) -----
# rank-0 (head) dist-init address on your fabric subnet, and the port.
SGLANG_HEAD_IP=10.0.0.1
SGLANG_DIST_PORT=25000

# ----- wedge-watcher (multi-Spark only; leave blank on a single Spark) -----
# Hostname/alias of the OTHER node (must resolve, e.g. via /etc/hosts).
SGLANG_PEER_HOST=
# A user with cross-node SSH keys + NOPASSWD sudo for `systemctl stop`.
SGLANG_SSH_USER=

# ===== GB10 200G ConnectX-7 fabric — validated defaults (same NIC on every Spark) =====
# GB10 splits one 200G QSFP cable across TWO PCIe x4 functions ("twins").
# Software must use both HCAs or NCCL silently caps at ~100 Gbps / ~12 GB/s.
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_IB_MERGE_NICS=1
NCCL_IB_DISABLE=0
# RoCEv2 GID. 'auto' lets NCCL pick; pin if you see the wrong GID chosen.
# NCCL_IB_GID_INDEX=3
# Bootstrap / out-of-band socket — picks ONE interface (cannot be a list).
# Also reused by the launch scripts for GLOO_SOCKET_IFNAME / TP_SOCKET_IFNAME.
NCCL_SOCKET_IFNAME=enp1s0f1np1
# AWS OFI NCCL plugin mis-detects DMABUF on Spark and silently drops to TCP
# (~3 GB/s). Force off.
NCCL_NET_PLUGIN=none
# UCX (some MPI / torch.distributed paths).
UCX_NET_DEVICES=enp1s0f1np1,enP2p1s0f1np1
# OpenMPI: keep its TCP control plane off the LAN/wifi.
OMPI_MCA_btl_tcp_if_include=enp1s0f1np1
OMPI_MCA_oob_tcp_if_include=enp1s0f1np1
# Diagnostics — NCCL_DEBUG=INFO shows "via NET/IB/0[1]" lines that prove both
# twins are in use. Leave unset for quiet production.
# NCCL_DEBUG=INFO
# NCCL_DEBUG_SUBSYS=INIT,NET
