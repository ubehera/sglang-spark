+    # FUSE, and similar shared filesystems often lack cuFile and fail at
+    # loader.copy_files_to_device() time.
+    from sglang.srt.environ import envs
+
+    nogds = envs.SGLANG_FASTSAFETENSORS_NOGDS.get()
 
